# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# MySQL connection (TiDB Cloud: Connect -> "General" connection string)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/invoicedesk
# Set to false only for MySQL running on your own computer (no TLS)
DB_SSL=true

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# AI assistant (at least one; leave both empty to use the built-in simple assistant)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
